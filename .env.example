DATABASE_URL="postgresql://iam_crm_runtime:runtime-password-change-me@localhost:5432/iam_crm?schema=public"
# Privileged owner URL used only by `prisma migrate deploy`; never expose it to
# ordinary API requests. Provision iam_crm_runtime with scripts/rls-runtime-role.sql.
MIGRATION_DATABASE_URL="postgresql://iam_crm:changeme@localhost:5432/iam_crm?schema=public"

JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="30d"
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAME_SITE=lax
REFRESH_TOKEN_COOKIE_PATH=/api/auth

PORT=3000

# Scheduled Notification Core scanner. Keep false on passive API replicas.
NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_SCHEDULER_INTERVAL_MINUTES=5

# Durable notification delivery worker. Enable it on at least one API replica.
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_MS=5000
NOTIFICATION_WORKER_BATCH_SIZE=50
NOTIFICATION_RETRY_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_DELAY_SECONDS=30
NOTIFICATION_RETRY_MAX_DELAY_SECONDS=3600
NOTIFICATION_PROCESSING_LEASE_SECONDS=300

CORS_ORIGINS=http://localhost:5173,http://89.42.199.159:8080
CORS_CREDENTIALS=true
FRONTEND_URL="http://localhost:5173"

SSO_SECRET_ENCRYPTION_KEY="change-this-to-a-32-plus-character-secret"
SSO_TICKET_TTL=120
FRONTEND_SSO_CALLBACK_URL="http://localhost:5173/auth/sso/callback"
BACKEND_PUBLIC_URL="http://localhost:3000"

WEBAUTHN_RP_NAME="IAM CRM"
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:5173"

# Tenant-aware CRM assistant and authenticated MCP endpoint (/api/mcp).
# MCP supplies permission-scoped CRM tools; an LLM is still required to select
# tools and compose answers. Groq is the default reasoning provider here.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional provider-neutral override for an OpenAI-compatible API.
# LLM_API_KEY=
# LLM_MODEL=ps/poolside/laguna-s-2.1
# LLM_BASE_URL=http://10.10.20.123:20128/v1
# LLM_API_MODE=chat_completions
# LLM_TIMEOUT_MS=120000
# Alternative lower-capacity model: ps/poolside/laguna-xs-2.1

# Legacy OpenAI settings remain supported as a fallback.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4
# OPENAI_BASE_URL=https://api.openai.com/v1
